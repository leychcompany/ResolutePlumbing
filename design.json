{
  "project_name": "Resolute Plumbing Brand Identity",
  "version": "1.1.0",
  "colors": {
    "primary": "#0A3161",
    "secondary": "#B31942",
    "accent": "#FFFFFF",
    "background": {
      "main": "#FFFFFF",
      "alt": "#F8F9FA"
    },
    "text": {
      "primary": "#0A3161",
      "secondary": "#333333",
      "inverse": "#FFFFFF"
    },
    "border": "#DEE2E6"
  },
  "typography": {
    "headings": {
      "family": "Montserrat, sans-serif",
      "weight": 700,
      "transform": "uppercase"
    },
    "body": {
      "family": "Source Sans Pro, sans-serif",
      "weight": 400,
      "line_height": 1.6
    }
  },
  "branding": {
    "entity_name": "Resolute Plumbing",
    "slogan": "Unwavering Quality. Patriotic Service.",
    "visual_keywords": ["Steady", "Robust", "Traditional", "Honest"],
    "iconography": "Bold, thick-lined icons; shield or crest motifs"
  },
  "components": {
    "buttons": {
      "primary": {
        "bg": "#B31942",
        "text": "#FFFFFF",
        "border_radius": "2px",
        "label": "Schedule Service"
      },
      "secondary": {
        "bg": "transparent",
        "text": "#0A3161",
        "border": "2px solid #0A3161",
        "label": "Our Services"
      }
    },
    "header": {
      "sticky": true,
      "bg": "#0A3161",
      "text": "#FFFFFF"
    },
    "cards": {
      "shadow": "0 8px 16px rgba(10, 49, 97, 0.08)",
      "border_top": "4px solid #B31942"
    }
  },
  "contact": {
    "phone_display": "Primary CTA",
    "highlight_color": "#B31942"
  }
}
